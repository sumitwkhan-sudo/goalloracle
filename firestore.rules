rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All collections: read-only from client
    // All writes go through Vercel serverless functions using Firebase Admin SDK
    // (Admin SDK bypasses these rules entirely)
    
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /predictions/{predId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /matchResults/{matchId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /adminLogs/{logId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
