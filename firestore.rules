rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.id == userId;
      // Block self-mutation of fields that must come from the server (admin SDK).
      // walletAddress + assignment trail are admin-managed; deviceFingerprint /
      // signupIpHash / banned* are anti-Sybil bookkeeping; verified is a future
      // hook. usernameSet flips once via /api/user with profanity validation.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny([
                         'role',
                         'createdAt',
                         'walletAddress',
                         'walletAssignedBy',
                         'walletAssignedAt',
                         'verified',
                         'deviceFingerprint',
                         'signupIpHash',
                         'emailDedupeKey',
                         'banned',
                         'bannedReason',
                         'bannedAt'
                       ]);
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid;
      // No client-side league updates. All mutations (rename, join, leave,
      // membership, prize/passcode changes) go through /api/leagues which
      // uses the admin SDK and bypasses rules.
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    match /predictions/{predId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.userId == request.auth.uid;
    }

    // Simple Mode predictions — one doc per (user, league) pair with composite
    // doc ID `${userId}__${leagueId}`. Legacy docs with doc ID == userId
    // (pre-per-league refactor) represent the user's Global Simple picks and
    // are still writable by that user.
    // Reads are public so leaderboards work.
    match /simplePredictions/{docId} {
      allow read: if true;
      // Create / update: the auth'd user must own the doc (resource.data.userId
      // matches their uid). The legacy path (docId == userId) is still supported.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && (docId == request.auth.uid
                        || docId.matches('^' + request.auth.uid + '__.+'));
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    // submittedAt is the tiebreaker — never overwrite once set
                    && (!('submittedAt' in resource.data)
                        || resource.data.submittedAt == null
                        || request.resource.data.submittedAt == resource.data.submittedAt);

      // Per-league score docs under the prediction doc.
      // Writes come from the server (admin SDK bypasses rules); clients only read.
      match /scores/{leagueId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // League members subcollection (used by global-simple for ranking).
    // Server (admin SDK) handles writes on signup/backfill/score update.
    match /leagues/{leagueId}/members/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Server-only data — clients never read or write directly.
    match /matchResults/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /adminLogs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    // Email-OTP codes. Server-only — clients must never read or write
    // these (would leak code hashes). The /api/auth/* endpoints use the
    // admin SDK and bypass these rules.
    match /authCodes/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Anti-Sybil bookkeeping — IP rate-limit counters, device-fingerprint
    // → user-id index, banned-IP list. All server-managed.
    match /signupAttempts/{ipHash} {
      allow read: if false;
      allow write: if false;
    }
    match /deviceFingerprints/{visitorId} {
      allow read: if false;
      allow write: if false;
    }
    match /bannedIps/{ipHash} {
      allow read: if false;
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if true;
    }

    // Admin-toggleable feature flags. Public read so every client (incl.
    // unauthenticated landing-page visitors) gets the same hide/show
    // treatment via the live subscription. Writes go through /api/admin
    // which uses the admin SDK and bypasses these rules.
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
