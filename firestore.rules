rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.id == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['role', 'createdAt']);
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    match /predictions/{predId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.userId == request.auth.uid;
    }

    // Simple Mode predictions — one doc per (user, league) pair with composite
    // doc ID `${userId}__${leagueId}`. Legacy docs with doc ID == userId
    // (pre-per-league refactor) represent the user's Global Simple picks and
    // are still writable by that user.
    // Reads are public so leaderboards work.
    match /simplePredictions/{docId} {
      allow read: if true;
      // Create / update: the auth'd user must own the doc (resource.data.userId
      // matches their uid). The legacy path (docId == userId) is still supported.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && (docId == request.auth.uid
                        || docId.matches('^' + request.auth.uid + '__.+'));
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    // submittedAt is the tiebreaker — never overwrite once set
                    && (!('submittedAt' in resource.data)
                        || resource.data.submittedAt == null
                        || request.resource.data.submittedAt == resource.data.submittedAt);

      // Per-league score docs under the prediction doc.
      // Writes come from the server (admin SDK bypasses rules); clients only read.
      match /scores/{leagueId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // League members subcollection (used by global-simple for ranking).
    // Server (admin SDK) handles writes on signup/backfill/score update.
    match /leagues/{leagueId}/members/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /matchResults/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /adminLogs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if true;
    }
  }
}
