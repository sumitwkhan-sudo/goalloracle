rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Self-read only. email / walletAddress / signupIpHash / fingerprint
      // live on this doc and would otherwise leak to anyone with a Firebase
      // SDK. Anything that needs another user's display name / country /
      // role goes through /api/* (admin SDK), which bypasses these rules.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.id == userId;
      // Block self-mutation of fields that must come from the server (admin SDK).
      // walletAddress + assignment trail are admin-managed; deviceFingerprint /
      // signupIpHash / banned* are anti-Sybil bookkeeping; verified is a future
      // hook. displayName / displayNameLower are routed through /api/user so
      // the server can enforce uniqueness + profanity + reserved-name rules.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny([
                         'role',
                         'createdAt',
                         'walletAddress',
                         'walletAssignedBy',
                         'walletAssignedAt',
                         'verified',
                         'deviceFingerprint',
                         'signupIpHash',
                         'emailDedupeKey',
                         'displayName',
                         'displayNameLower',
                         'usernameSet',
                         'banned',
                         'bannedReason',
                         'bannedAt'
                       ]);
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid;
      // No client-side league updates. All mutations (rename, join, leave,
      // membership, prize/passcode changes) go through /api/leagues which
      // uses the admin SDK and bypasses rules.
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    match /predictions/{predId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.userId == request.auth.uid;
    }

    // Quick Picks predictions — one doc per (user, league) pair with composite
    // doc ID `${userId}__${leagueId}`. Reads are public so leaderboards and
    // public bracket views work.
    //
    // Writes are SERVER-ONLY via /api/simple-predictions, which validates
    // stage locks (group stage / R32 / R16 / QF / SF / 3rd / Final each
    // freeze 5 minutes before that stage's first match kicks off). Without
    // server enforcement a user with devtools could edit picks for matches
    // already in progress.
    match /simplePredictions/{docId} {
      allow read: if true;
      allow write: if false;

      // Per-league score docs under the prediction doc. Server-only writes.
      match /scores/{leagueId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // League members subcollection (used by global-simple for ranking).
    // Server (admin SDK) handles writes on signup/backfill/score update.
    match /leagues/{leagueId}/members/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Private league config — currently holds the passcode for private
    // leagues, which used to live on the parent doc and was therefore
    // world-readable. Server-only.
    match /leagues/{leagueId}/private/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Server-only data — clients never read or write directly.
    match /matchResults/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /adminLogs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    // Email-OTP codes. Server-only — clients must never read or write
    // these (would leak code hashes). The /api/auth/* endpoints use the
    // admin SDK and bypass these rules.
    match /authCodes/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Anti-Sybil bookkeeping — IP rate-limit counters, device-fingerprint
    // → user-id index, banned-IP list. All server-managed.
    match /signupAttempts/{ipHash} {
      allow read: if false;
      allow write: if false;
    }
    match /deviceFingerprints/{visitorId} {
      allow read: if false;
      allow write: if false;
    }
    match /bannedIps/{ipHash} {
      allow read: if false;
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if true;
    }

    // Admin-toggleable feature flags. Public read so every client (incl.
    // unauthenticated landing-page visitors) gets the same hide/show
    // treatment via the live subscription. Writes go through /api/admin
    // which uses the admin SDK and bypasses these rules.
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
