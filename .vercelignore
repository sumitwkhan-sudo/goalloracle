# Files Vercel doesn't need — excluded from the deployment upload.
# Keeps only what's needed to build + run (src/, api/, public/, config files).

# Test files & tooling
**/*.test.js
**/*.test.jsx
**/*.spec.js

# Migration / maintenance scripts — but keep the pre-deploy API import
# guard, which runs as part of `npm run build` on Vercel. (Using
# `scripts/*` + negation rather than `scripts/` so the re-include works;
# gitignore can't re-include a file whose parent dir is fully excluded.)
scripts/*
!scripts/check-api-imports.mjs

# Smart contract source (not used by the web app)
contracts/

# Local build output (Vercel rebuilds)
dist/

# Local env + DS_Store
.env
.env.local
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Claude session + scratch
.claude/
