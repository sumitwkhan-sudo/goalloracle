{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "0 4 * * *" },
    { "path": "/api/cron/poll-results", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/daily-report", "schedule": "0 8 * * *" },
    { "path": "/api/cron/incomplete-bracket-reminder", "schedule": "0 * * * *" },
    { "path": "/api/cron/seo-check", "schedule": "0 5 * * *" },
    { "path": "/api/cron/outreach-drain", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/llms-full.txt", "destination": "/llms-full.txt" },
    { "source": "/openapi.json", "destination": "/openapi.json" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/logo.svg", "destination": "/logo.svg" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt|llms-full.txt|openapi.json|manifest.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/logo.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }
      ]
    }
  ]
}
