# ─── Firebase (client) ───────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Firebase Admin (server-side, /api routes + scripts) ─────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Email OTP (Resend) ──────────────────────────────────────────
# Without RESEND_API_KEY the request-code endpoint logs codes to the
# server console as a dev fallback so local development still works.
RESEND_API_KEY=
RESEND_FROM_EMAIL="GoalOracle <noreply@goaloracle.com>"

# ─── Google OAuth ────────────────────────────────────────────────
# Web Client ID from Google Cloud Console > APIs & Services > Credentials.
# Must match the Client ID configured in the Firebase Auth Google provider
# so signInWithPopup tokens validate against the same audience.
GOOGLE_OAUTH_CLIENT_ID=
